# QUANT DERIV AI — environment template (DEMO only)
# Copy to .env and fill locally. Never commit real credentials.
# Never log API tokens or passwords.

# Runtime
QUANT_ENV=development
QUANT_LOG_LEVEL=INFO
QUANT_CONFIG_PATH=config/default.yaml

# Trading mode — DEMO only for this phase. Do not set live/real.
QUANT_TRADING_MODE=demo

# -----------------------------------------------------------------------------
# Primary connection: Deriv WebSocket API (official)
# -----------------------------------------------------------------------------
# 1. Register an application at https://api.deriv.com → obtain DERIV_APP_ID
# 2. Create an API token for a DEMO/virtual account (scopes: read / trade as needed)
#    in Deriv account settings → API token
# 3. Endpoint defaults to the official host; override only if Deriv documents another.
#
# Official WebSocket URL shape:
#   wss://ws.derivws.com/websockets/v3?app_id=<DERIV_APP_ID>
# Auth message: {"authorize":"<DERIV_API_TOKEN>"}
# Demo gate: authorize.is_virtual must be 1 (fail-closed on real accounts).
DERIV_APP_ID=
DERIV_API_TOKEN=
DERIV_ENDPOINT=wss://ws.derivws.com/websockets/v3

# -----------------------------------------------------------------------------
# Optional / secondary: MetaTrader 5 (Windows terminal scaffold)
# -----------------------------------------------------------------------------
# Leave empty unless using the optional MT5 path. Prefer Deriv API above.
# Never put real/live account credentials here. Never commit a filled .env.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Windows path to terminal exe, e.g. C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=
