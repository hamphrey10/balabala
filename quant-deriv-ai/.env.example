# QUANT DERIV AI — environment template (DEMO only)
# Copy to .env and fill locally. Never commit real credentials.

# Runtime
QUANT_ENV=development
QUANT_LOG_LEVEL=INFO
QUANT_CONFIG_PATH=config/default.yaml

# Trading mode — DEMO only for this phase. Do not set live/real.
QUANT_TRADING_MODE=demo

# MT5 DEMO credentials (optional; used only when connecting — LOT-002+)
# Leave empty until a DEMO account is configured out-of-band.
# Never put real/live account credentials here. Never commit a filled .env.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Windows path to terminal exe, e.g. C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=
